{
  "appId": "com.safenet.app",
  "appName": "SafeNet",
  "webDir": "build",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F6F9FD"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#F6F9FD",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F6F9FD"
    }
  }
}
